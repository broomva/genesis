[Unit]
Description=Genesis api (Hono/Bun)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __HOME__ and __REPO__ are filled in by `genesis install`; this template is for
# reference / manual installs. The start script sources env.sh (PATH, token, etc).
ExecStart=/bin/bash __HOME__/.config/genesis-bot/start-api.sh
WorkingDirectory=__REPO__
Restart=on-failure
RestartSec=10

# Tenant compute bound (BRO-2275, shipped to the box as a drop-in on 2026-08-24;
# carried here by BRO-2260 so a fresh install is not silently weaker than the
# running one). genesis-api spawns every tenant `claude -p` turn as a child, so
# this cgroup IS the whole tenant compute surface.
#
# 2026-08-23: a tenant cloned a 197 MB repo and asked the agent to run it. CPU sat
# at 100% and memory near 8 GB of 8.59 for two and a half hours. Nothing was
# OOM-killed -- the box simply had no capacity left, the webhook listener could not
# answer inside Kapso's timeout, and three messages were lost for good (Kapso
# retries three times, then drops).
#
# DELIBERATELY NOT ON genesis-bot. The bot owns the webhook listener, and that
# listener answering in time is the property that must survive a tenant saturating
# the box. Bounding compute while leaving ingress unbounded is the design: a
# runaway turn degrades that tenant's turn, never the channel.
#
# Sized for a 2 vCPU / 8 GB box. 150% of 200% leaves a core for the bot, the web
# app, tailscaled and sshd. GENESIS_MAX_TURNS defaults to 2 because a measured
# turn is 1.2-1.9 GB RSS and two fit under MemoryMax while three do not -- if you
# change MemoryMax, change that too, or the cap stops matching the memory.
MemoryHigh=3G
MemoryMax=4G
CPUQuota=150%
TasksMax=512

[Install]
WantedBy=default.target
